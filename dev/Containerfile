# Dev container for working on powerbash.
#
# Built by `make toolbox` and entered with `make shell`. The point is a
# throwaway shell where sourcing powerbash.sh, breaking the prompt, and
# writing ~/.config/powerbashrc costs nothing -- toolbox/distrobox bind mount
# $HOME, so the repo is visible at the same path with no volume config.
#
# Everything below is something a segment renderer actually touches:
#   git          - the git segment
#   ncurses      - tput, the color palette
#   ncurses-term - terminfo for terminals the base image does not know.
#                  toolbox propagates the host's $TERM into the container, so
#                  a ghostty or wezterm user would otherwise hand tput a name
#                  it cannot resolve -- and powerbash then renders with no
#                  color at all, because every setaf/setab comes back empty.
#   coreutils    - timeout, for `powerbash git timeout`
#   python3      - the virtualenv segment (python3 -m venv)
#   ShellCheck   - the lint gate CI enforces
#   make         - the task runner, so the targets work inside the container too
#   podman       - so `make test-bash32` works from inside the toolbox too
FROM registry.fedoraproject.org/fedora-toolbox:latest

RUN dnf install -y \
      ShellCheck \
      coreutils \
      git \
      make \
      ncurses \
      ncurses-term \
      podman \
      procps-ng \
      python3 \
      python3-pip \
      which \
    && dnf clean all

# Non-login shells inside the container should behave like a user's would.
ENV TERM=xterm-256color
